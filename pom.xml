<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.lrj.workflow</groupId>
    <artifactId>workflow-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>workflow-platform</name>
    <description>内部统一流程/审批中台 (Flowable BPMN + 消费方 SDK 接入)</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Phase 0 硬门禁:锁定前的候选版本;spike 通过后在此固化 -->
        <flowable.version>7.1.0</flowable.version>
    </properties>

    <modules>
        <module>workflow-platform-protocol</module>
        <module>workflow-platform-core</module>
        <module>workflow-platform-sdk</module>
        <module>workflow-platform-server</module>
        <module>workflow-platform-admin</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Flowable 版本统一由 BOM 管理 -->
            <dependency>
                <groupId>org.flowable</groupId>
                <artifactId>flowable-bom</artifactId>
                <version>${flowable.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 自有模块 -->
            <dependency>
                <groupId>com.lrj.workflow</groupId>
                <artifactId>workflow-platform-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lrj.workflow</groupId>
                <artifactId>workflow-platform-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lrj.workflow</groupId>
                <artifactId>workflow-platform-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
