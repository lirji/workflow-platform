# 复制为 .env.local 按需覆盖
VITE_API_BASE_URL=            # 空=相对路径,dev 走 vite proxy / prod 走 nginx 同源反代到 :8300
VITE_API_TARGET=http://localhost:8300   # 仅 dev proxy 目标(不进产物)
VITE_WORKFLOW_TENANT=his      # 试点单租户;Phase 3 后端从 JWT 派生后可移除
# 鉴权:Stage 1 dev 可置 false 直连联调;Stage 2 置 true 接 Casdoor SSO
VITE_AUTH_ENABLED=false
VITE_CASDOOR_AUTHORITY=http://localhost:8000
VITE_CASDOOR_CLIENT_ID=       # Casdoor 的 workflow-console 应用 client_id
VITE_OIDC_SCOPE=openid profile
