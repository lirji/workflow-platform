# 复制为 .env.local 按需覆盖
VITE_API_BASE_URL=            # 空=相对路径,dev 走 vite proxy / prod 走 nginx 同源反代到 :8300
VITE_API_TARGET=http://localhost:8300   # 仅 dev proxy 目标(不进产物)
VITE_WORKFLOW_TENANT=his      # 试点单租户;Phase 3 后端从 JWT 派生后可移除
# 鉴权分期(登录页 /login 已就绪):
#   false = Stage1 dev,ProtectedRoute 放行直连 :8300,/login 显示"开发模式·免登录"入口。
#   true  = Stage2,未登录跳品牌页 /login → "使用统一身份登录" → Casdoor SSO(授权码+PKCE)。
#           置 true 前须先在 Casdoor 注册应用拿 client_id(见 README「Casdoor OIDC 接入」)。
#           注意:后端 WORKFLOW_SECURITY_ENABLED=true 会强制 JWT、打断明文头 shadow 联调,单独分期。
VITE_AUTH_ENABLED=false
VITE_CASDOOR_AUTHORITY=http://localhost:8000   # Casdoor issuer
VITE_CASDOOR_CLIENT_ID=       # Casdoor 的 workflow-console 应用 client_id(Stage2 必填)
VITE_OIDC_SCOPE=openid profile
