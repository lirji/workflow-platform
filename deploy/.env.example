# 复制为 .env 后使用。所有端口变量化,避开现有项目占用(his 9000-9007 / auth 8000,8200-8202,15432 / recsys 8080-8090 / search 18090,19200)。
COMPOSE_PROJECT_NAME=workflow-platform

# 独立 PostgreSQL(Flowable ACT_* + 平台 wf_* 元数据表)
WORKFLOW_PG_PORT=25432
WORKFLOW_PG_DB=workflow
WORKFLOW_PG_USER=workflow
WORKFLOW_PG_PASSWORD=workflow

# 仅缓存/限流预留,正确性逻辑不依赖它(FINAL_PLAN §6.1)
WORKFLOW_REDIS_PORT=26379

# Kafka(KRaft 单节点):host 访问端口(容器内服务用 kafka:9092)
WORKFLOW_KAFKA_HOST_PORT=29092
WORKFLOW_KAFKA_DELIVERY_TIMEOUT_MS=8000
WORKFLOW_KAFKA_REQUEST_TIMEOUT_MS=5000
WORKFLOW_KAFKA_MAX_BLOCK_MS=5000

# Outbox：Kafka max.block(默认 5s)+ACK 等待(默认 10s)必须严格小于 lease(默认 30s)。
WORKFLOW_OUTBOX_SEND_TIMEOUT_SECONDS=10
WORKFLOW_OUTBOX_MAX_ATTEMPTS=10
WORKFLOW_OUTBOX_RETRY_BACKOFF_SECONDS=5

# 中台服务端口
WORKFLOW_SERVER_PORT=8300
WORKFLOW_ADMIN_PORT=8301
WORKFLOW_CONSOLE_PORT=8302

# 前端构建参数。默认免登录开发模式；启用 OIDC 时同时开启后端鉴权并填写 client_id/JWKS。
VITE_API_BASE_URL=
VITE_WORKFLOW_TENANT=his
VITE_AUTH_ENABLED=false
VITE_CASDOOR_AUTHORITY=http://localhost:8000
VITE_CASDOOR_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile

# 鉴权(生产置 true;需配 JWKS)。默认 false 保联调明文头路径。
WORKFLOW_SPRING_PROFILES_ACTIVE=dev
WORKFLOW_SECURITY_ENABLED=false
WORKFLOW_OIDC_ISSUER=
WORKFLOW_OIDC_JWKS=
WORKFLOW_OIDC_AUDIENCE=
WORKFLOW_GROUPS_CLAIM=groups
WORKFLOW_TENANT_CLAIM=

# Kafka 入站 source→tenant allowlist + 每 source HMAC。生产必须开启；key 为至少 32 随机字节的 Base64URL。
# producer 必须对原始 UTF-8 JSON 做 HmacSHA256，并把 Base64URL 签名放入 header `workflow-signature-v1`。
# 仍需在生产 Kafka 集群启用 SASL/TLS，并用 ACL 限制 producer 对 topic 的写权限。
WORKFLOW_KAFKA_TRUST_ENABLED=false
WORKFLOW_KAFKA_SOURCE_TENANT_BINDINGS=
WORKFLOW_KAFKA_SOURCE_SIGNING_KEYS=

# Flowable ACT_* schema:dev=true(引擎自建/升级);生产=false(用固化官方 DDL 初始化,见 deploy/postgres/flowable-7.1.0 与 ADR 0001)
WORKFLOW_FLOWABLE_SCHEMA_UPDATE=true
