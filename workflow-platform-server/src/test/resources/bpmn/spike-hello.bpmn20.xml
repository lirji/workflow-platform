<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://lrj.com/workflow/spike">

  <!-- Phase 0 兼容验证用最简流程:start -> 人工审核(候选组 reviewers) -> end -->
  <process id="spikeHello" name="Spike Hello" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="review"/>
    <userTask id="review" name="人工审核" flowable:candidateGroups="reviewers"/>
    <sequenceFlow id="f2" sourceRef="review" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
