<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://lrj.com/workflow/benefit">

  <message id="msgBenefitSkuGoLiveApplied" name="benefitSkuGoLiveApplied"/>

  <!-- SKU 首次上线四眼审批。人工办理仅登记决定，benefit-center 落地并 ACK 后流程才结束。 -->
  <process id="benefitSkuGoLive" name="权益 SKU 首次上线审批" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="f_start_review" sourceRef="start" targetRef="skuGoLiveReview"/>

    <userTask id="skuGoLiveReview" name="SKU 上线审批"
              flowable:candidateGroups="BENEFIT_SKU_REVIEWER"/>
    <sequenceFlow id="f_review_gateway" sourceRef="skuGoLiveReview" targetRef="decisionGateway"/>

    <exclusiveGateway id="decisionGateway" name="审批结论" default="f_invalid_repair"/>
    <sequenceFlow id="f_decision_action" sourceRef="decisionGateway" targetRef="prepareSkuAction">
      <conditionExpression xsi:type="tFormalExpression">${decision == 'PASS' || decision == 'REJECT'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_invalid_repair" sourceRef="decisionGateway" targetRef="manualRepair"/>

    <serviceTask id="prepareSkuAction" name="登记 SKU 状态动作"
                 flowable:delegateExpression="${skuGoLiveActionOutboxDelegate}"/>
    <sequenceFlow id="f_action_wait" sourceRef="prepareSkuAction" targetRef="waitApplied"/>

    <intermediateCatchEvent id="waitApplied" name="等待权益中台落地 ACK">
      <messageEventDefinition messageRef="msgBenefitSkuGoLiveApplied"/>
    </intermediateCatchEvent>
    <sequenceFlow id="f_wait_gateway" sourceRef="waitApplied" targetRef="appliedGateway"/>

    <exclusiveGateway id="appliedGateway" name="业务是否落地" default="f_applied_repair"/>
    <sequenceFlow id="f_applied_end" sourceRef="appliedGateway" targetRef="end">
      <conditionExpression xsi:type="tFormalExpression">${appliedStatus == 'APPLIED'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_applied_repair" sourceRef="appliedGateway" targetRef="manualRepair"/>

    <userTask id="manualRepair" name="人工处置（不自动投放）" flowable:candidateGroups="ADMIN"/>
    <sequenceFlow id="f_repair_end" sourceRef="manualRepair" targetRef="end"/>
    <endEvent id="end"/>
  </process>

  <bpmndi:BPMNDiagram id="D_benefitSkuGoLive">
    <bpmndi:BPMNPlane id="P_benefitSkuGoLive" bpmnElement="benefitSkuGoLive">
      <bpmndi:BPMNShape id="S_start" bpmnElement="start"><omgdc:Bounds x="120" y="210" width="28" height="28"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_review" bpmnElement="skuGoLiveReview"><omgdc:Bounds x="200" y="184" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_decision" bpmnElement="decisionGateway" isMarkerVisible="true"><omgdc:Bounds x="370" y="199" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_prepare" bpmnElement="prepareSkuAction"><omgdc:Bounds x="470" y="184" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_wait" bpmnElement="waitApplied"><omgdc:Bounds x="640" y="206" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_applied" bpmnElement="appliedGateway" isMarkerVisible="true"><omgdc:Bounds x="725" y="199" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_repair" bpmnElement="manualRepair"><omgdc:Bounds x="690" y="330" width="125" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_end" bpmnElement="end"><omgdc:Bounds x="845" y="210" width="28" height="28"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_start_review" bpmnElement="f_start_review"><omgdi:waypoint x="148" y="224"/><omgdi:waypoint x="200" y="224"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_review_gateway" bpmnElement="f_review_gateway"><omgdi:waypoint x="320" y="224"/><omgdi:waypoint x="370" y="224"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_decision_action" bpmnElement="f_decision_action"><omgdi:waypoint x="420" y="224"/><omgdi:waypoint x="470" y="224"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_action_wait" bpmnElement="f_action_wait"><omgdi:waypoint x="590" y="224"/><omgdi:waypoint x="640" y="224"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_wait_gateway" bpmnElement="f_wait_gateway"><omgdi:waypoint x="676" y="224"/><omgdi:waypoint x="725" y="224"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_applied_end" bpmnElement="f_applied_end"><omgdi:waypoint x="775" y="224"/><omgdi:waypoint x="845" y="224"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_invalid_repair" bpmnElement="f_invalid_repair"><omgdi:waypoint x="395" y="249"/><omgdi:waypoint x="395" y="370"/><omgdi:waypoint x="690" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_applied_repair" bpmnElement="f_applied_repair"><omgdi:waypoint x="750" y="249"/><omgdi:waypoint x="750" y="330"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_repair_end" bpmnElement="f_repair_end"><omgdi:waypoint x="815" y="370"/><omgdi:waypoint x="859" y="370"/><omgdi:waypoint x="859" y="238"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
