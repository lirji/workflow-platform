<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://lrj.com/workflow/his">

  <!-- 业务落地 ACK 用 message(非 signal,避免广播给多个订阅者);按 executionId 精确关联 -->
  <message id="msgRxReviewApplied" name="hisRxReviewApplied"/>

  <!--
    HIS 药师审方(v1)。ADR:回调以事件驱动为主 —— 人工节点 UserTask;审方结论写 outbox(prepareAction),
    由消费方(his-outpatient)落地后回 message 结束流程;未落地一律进人工处置,绝不自动通过。
    变量:encounterId,patientId,deptCode,doctorId,reviewRound,decision(PASS/REJECT),opinion,
         actorSub,actorUsername,actionId,appliedStatus(由 ACK 回填)。
  -->
  <process id="hisRxReview" name="HIS 药师审方" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="f_start_review" sourceRef="start" targetRef="pharmacistReview"/>

    <userTask id="pharmacistReview" name="药师审方" flowable:candidateGroups="PHARMACIST"/>
    <sequenceFlow id="f_review_gw" sourceRef="pharmacistReview" targetRef="decisionGw"/>

    <exclusiveGateway id="decisionGw" name="审方结论" default="f_decision_repair"/>
    <sequenceFlow id="f_decision_action" sourceRef="decisionGw" targetRef="prepareAction">
      <conditionExpression xsi:type="tFormalExpression">${decision == 'PASS' || decision == 'REJECT'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_decision_repair" sourceRef="decisionGw" targetRef="manualRepair"/>

    <!-- 只写 outbox 数据(同一 PG 事务);实际 Kafka 发布由 outbox publisher 负责。delegate 见 Phase 2。 -->
    <serviceTask id="prepareAction" name="登记业务动作(写 outbox)"
                 flowable:delegateExpression="${rxReviewActionOutboxDelegate}"/>
    <sequenceFlow id="f_action_wait" sourceRef="prepareAction" targetRef="waitApplied"/>

    <intermediateCatchEvent id="waitApplied" name="等待业务落地 ACK">
      <messageEventDefinition messageRef="msgRxReviewApplied"/>
    </intermediateCatchEvent>
    <sequenceFlow id="f_wait_appliedgw" sourceRef="waitApplied" targetRef="appliedGw"/>

    <exclusiveGateway id="appliedGw" name="业务是否落地" default="f_applied_repair"/>
    <sequenceFlow id="f_applied_end" sourceRef="appliedGw" targetRef="end">
      <conditionExpression xsi:type="tFormalExpression">${appliedStatus == 'APPLIED'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_applied_repair" sourceRef="appliedGw" targetRef="manualRepair"/>

    <userTask id="manualRepair" name="人工处置(不自动通过)" flowable:candidateGroups="ADMIN"/>
    <sequenceFlow id="f_repair_end" sourceRef="manualRepair" targetRef="end"/>

    <endEvent id="end"/>
  </process>

  <bpmndi:BPMNDiagram id="D_hisRxReview">
    <bpmndi:BPMNPlane id="P_hisRxReview" bpmnElement="hisRxReview">
      <bpmndi:BPMNShape id="S_start" bpmnElement="start">
        <omgdc:Bounds x="152" y="202" width="28" height="28"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_review" bpmnElement="pharmacistReview">
        <omgdc:Bounds x="230" y="176" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_decisionGw" bpmnElement="decisionGw" isMarkerVisible="true">
        <omgdc:Bounds x="390" y="191" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_prepareAction" bpmnElement="prepareAction">
        <omgdc:Bounds x="490" y="176" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_waitApplied" bpmnElement="waitApplied">
        <omgdc:Bounds x="652" y="198" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_appliedGw" bpmnElement="appliedGw" isMarkerVisible="true">
        <omgdc:Bounds x="740" y="191" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_manualRepair" bpmnElement="manualRepair">
        <omgdc:Bounds x="710" y="320" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_end" bpmnElement="end">
        <omgdc:Bounds x="852" y="202" width="28" height="28"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="E_f_start_review" bpmnElement="f_start_review">
        <omgdi:waypoint x="180" y="216"/>
        <omgdi:waypoint x="230" y="216"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_f_review_gw" bpmnElement="f_review_gw">
        <omgdi:waypoint x="340" y="216"/>
        <omgdi:waypoint x="390" y="216"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_f_decision_action" bpmnElement="f_decision_action">
        <omgdi:waypoint x="440" y="216"/>
        <omgdi:waypoint x="490" y="216"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_f_action_wait" bpmnElement="f_action_wait">
        <omgdi:waypoint x="600" y="216"/>
        <omgdi:waypoint x="652" y="216"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_f_wait_appliedgw" bpmnElement="f_wait_appliedgw">
        <omgdi:waypoint x="688" y="216"/>
        <omgdi:waypoint x="740" y="216"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_f_applied_end" bpmnElement="f_applied_end">
        <omgdi:waypoint x="790" y="216"/>
        <omgdi:waypoint x="852" y="216"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_f_decision_repair" bpmnElement="f_decision_repair">
        <omgdi:waypoint x="415" y="241"/>
        <omgdi:waypoint x="415" y="360"/>
        <omgdi:waypoint x="710" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_f_applied_repair" bpmnElement="f_applied_repair">
        <omgdi:waypoint x="765" y="241"/>
        <omgdi:waypoint x="765" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_f_repair_end" bpmnElement="f_repair_end">
        <omgdi:waypoint x="820" y="360"/>
        <omgdi:waypoint x="866" y="360"/>
        <omgdi:waypoint x="866" y="230"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
